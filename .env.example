# Nostromo backend (PocketBase 0.40.x core) used by this app.
# Copy this file to `.env` and adjust the value for your environment.
#
# Empty = same origin: requests go to `/api` and `/nostromo` on the page host.
# In development the Vite dev server proxies them to NOSTROMO_PROXY_TARGET
# (default http://127.0.0.1:8090).
# Or set an absolute origin such as http://localhost:8090 (no path prefix).
VITE_NOSTROMO_URL=
