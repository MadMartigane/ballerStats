{
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@fontsource/rajdhani": "^5.0.14",
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.14",
    "@tailwindcss/vite": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "browser-image-compression": "^2.0.2",
    "daisyui": "^5.6.14",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "idb-keyval": "^6.2.5",
    "jsdom": "^29.1.1",
    "lucide-solid": "^1.17.0",
    "postcss": "^8.4.41",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "ultracite": "7.8.1",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.1"
  },
  "name": "baller-stats",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "check": "ultracite check",
    "format": "ultracite fix",
    "format-force": "ultracite fix --unsafe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pre-prod": "vite build --base=/baller-stats-preprod/ && pnpm run pre-prod-only",
    "pre-prod-only": "pnpm run pre-prod-clean && pnpm run pre-prod-push",
    "pre-prod-clean": "rm -rf /var/www/marius.click/html/baller-stats-preprod/*",
    "pre-prod-push": "cp -r dist/* /var/www/marius.click/html/baller-stats-preprod/",
    "prod-clean": "rm -rf /var/www/marius.click/html/baller-stats/*",
    "prod-push": "cp -r dist/* /var/www/marius.click/html/baller-stats/",
    "prod": "vite build --base=/baller-stats/ && pnpm run prod-only",
    "prod-only": "pnpm run prod-clean && pnpm run prod-push",
    "fix": "ultracite fix"
  },
  "type": "module",
  "version": "0.0.1",
  "description": "Web app to collect and visualize your player statistics.",
  "license": "MIT"
}
